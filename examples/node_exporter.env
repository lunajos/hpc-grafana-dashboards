# node_exporter 1.11.1 baseline for Linux HPC nodes.
# Verify flags against the exact binary and enable only collectors supported by
# the kernel/hardware. Most listed collectors are already enabled by default.
NODE_EXPORTER_ARGS="--collector.hwmon --collector.infiniband --collector.nfs --collector.nfsd --collector.pressure --collector.rapl --collector.nvme --collector.edac --collector.softnet"

# mountstats supplies per-mount NFS detail but may increase scrape cost and can
# encounter slow/stale mounts. Pilot before enabling cluster-wide.
# NODE_EXPORTER_ARGS="$NODE_EXPORTER_ARGS --collector.mountstats"

