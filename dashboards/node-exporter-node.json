{
  "annotations": {"list": []}, "description": "Raw node_exporter drill-down using only job and instance labels.", "editable": true, "graphTooltip": 1, "id": null,
  "panels": [
    {"id": 1, "type": "stat", "title": "Up", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "up{job=~\"$job_regex\",instance=\"$instance\"}", "instant": true}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Logical CPUs", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"refId": "A", "expr": "count(node_cpu_seconds_total{job=~\"$job_regex\",instance=\"$instance\",mode=\"idle\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Physical memory", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "node_memory_MemTotal_bytes{job=~\"$job_regex\",instance=\"$instance\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "CPU busy", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{job=~\"$job_regex\",instance=\"$instance\",mode=\"idle\"}[5m]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "Memory used", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "1 - node_memory_MemAvailable_bytes{job=~\"$job_regex\",instance=\"$instance\"} / node_memory_MemTotal_bytes{job=~\"$job_regex\",instance=\"$instance\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "stat", "title": "Max temperature", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"refId": "A", "expr": "max(node_hwmon_temp_celsius{job=~\"$job_regex\",instance=\"$instance\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 7, "type": "timeseries", "title": "CPU modes", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"refId": "A", "expr": "avg by (mode) (rate(node_cpu_seconds_total{job=~\"$job_regex\",instance=\"$instance\"}[$__rate_interval]))", "legendFormat": "{{mode}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Load average", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"refId": "A", "expr": "node_load1{job=~\"$job_regex\",instance=\"$instance\"}", "legendFormat": "1m"}, {"refId": "B", "expr": "node_load5{job=~\"$job_regex\",instance=\"$instance\"}", "legendFormat": "5m"}, {"refId": "C", "expr": "node_load15{job=~\"$job_regex\",instance=\"$instance\"}", "legendFormat": "15m"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "Temperature sensors", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"refId": "A", "expr": "node_hwmon_temp_celsius{job=~\"$job_regex\",instance=\"$instance\"}", "legendFormat": "{{chip}} {{sensor}}"}], "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Network throughput", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"refId": "A", "expr": "rate(node_network_receive_bytes_total{job=~\"$job_regex\",instance=\"$instance\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval])", "legendFormat": "{{device}} RX"}, {"refId": "B", "expr": "-rate(node_network_transmit_bytes_total{job=~\"$job_regex\",instance=\"$instance\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval])", "legendFormat": "{{device}} TX"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Disk utilization", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"refId": "A", "expr": "rate(node_disk_io_time_seconds_total{job=~\"$job_regex\",instance=\"$instance\",device!~\"loop.*|ram.*\"}[$__rate_interval])", "legendFormat": "{{device}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Filesystem used", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "targets": [{"refId": "A", "expr": "1 - node_filesystem_avail_bytes{job=~\"$job_regex\",instance=\"$instance\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"} / node_filesystem_size_bytes{job=~\"$job_regex\",instance=\"$instance\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"}", "legendFormat": "{{mountpoint}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}}
  ],
  "refresh": "30s", "schemaVersion": 41, "tags": ["hpc", "node-exporter", "node"],
  "templating": {"list": [
    {"name": "job_regex", "label": "Prometheus job regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}},
    {"name": "host_regex", "label": "Hostname / instance regex", "type": "textbox", "query": "cn[0-9]{4}(:9100)?", "current": {"text": "cn[0-9]{4}(:9100)?", "value": "cn[0-9]{4}(:9100)?"}},
    {"name": "instance", "label": "Node instance", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(up{job=~\"$job_regex\",instance=~\"$host_regex\"}, instance)"}, "includeAll": false, "multi": false, "refresh": 1}
  ]},
  "time": {"from": "now-6h", "to": "now"}, "timezone": "browser", "title": "HPC / Node Exporter Node", "uid": "hpc-node-exporter-node", "version": 1
}
