{
  "annotations": {"list": []},
  "description": "Start here: fleet dashboard for unmodified node_exporter metrics. No custom labels or recording rules required.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {"id": 1, "type": "stat", "title": "Matched nodes", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "count(up{job=~\"$job_regex\",instance=~\"$host_regex\"})", "instant": true}], "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "blue"}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Nodes down", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"refId": "A", "expr": "count(up{job=~\"$job_regex\",instance=~\"$host_regex\"} == 0)", "instant": true}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Logical CPUs online", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "count(node_cpu_seconds_total{job=~\"$job_regex\",instance=~\"$host_regex\",mode=\"idle\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Total memory", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "sum(node_memory_MemTotal_bytes{job=~\"$job_regex\",instance=~\"$host_regex\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "gauge", "title": "Fleet CPU busy", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{job=~\"$job_regex\",instance=~\"$host_regex\",mode=\"idle\"}[5m]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "gauge", "title": "Fleet memory used", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"refId": "A", "expr": "1 - sum(node_memory_MemAvailable_bytes{job=~\"$job_regex\",instance=~\"$host_regex\"}) / sum(node_memory_MemTotal_bytes{job=~\"$job_regex\",instance=~\"$host_regex\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 7, "type": "stat", "title": "Node reachability cells", "description": "One cell per standard Prometheus instance. Click a cell for raw node_exporter drill-down.", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 4}, "targets": [{"refId": "A", "expr": "up{job=~\"$job_regex\",instance=~\"$host_regex\"}", "legendFormat": "{{instance}}", "instant": true}], "fieldConfig": {"defaults": {"links": [{"title": "Open ${__field.name}", "url": "/d/hpc-node-exporter-node?var-job_regex=$job_regex&var-host_regex=$host_regex&var-instance=${__field.name}"}], "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "name_and_value", "wideLayout": false, "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 8, "type": "status-history", "title": "CPU busy by node", "gridPos": {"h": 12, "w": 12, "x": 0, "y": 16}, "targets": [{"refId": "A", "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{job=~\"$job_regex\",instance=~\"$host_regex\",mode=\"idle\"}[5m]))", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}}, "overrides": []}, "options": {"showValue": "never", "rowHeight": 0.7}},
    {"id": 9, "type": "status-history", "title": "Memory used by node", "gridPos": {"h": 12, "w": 12, "x": 12, "y": 16}, "targets": [{"refId": "A", "expr": "1 - node_memory_MemAvailable_bytes{job=~\"$job_regex\",instance=~\"$host_regex\"} / node_memory_MemTotal_bytes{job=~\"$job_regex\",instance=~\"$host_regex\"}", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "orange", "value": 0.85}, {"color": "red", "value": 0.95}]}}, "overrides": []}, "options": {"showValue": "never", "rowHeight": 0.7}},
    {"id": 10, "type": "status-history", "title": "Maximum hwmon temperature by node", "description": "Empty when the hwmon collector or host sensors are unavailable.", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 28}, "targets": [{"refId": "A", "expr": "max by (instance) (node_hwmon_temp_celsius{job=~\"$job_regex\",instance=~\"$host_regex\"})", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "celsius", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"showValue": "never", "rowHeight": 0.7}}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["hpc", "node-exporter", "start-here"],
  "templating": {"list": [
    {"name": "job_regex", "label": "Prometheus job regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}},
    {"name": "host_regex", "label": "Hostname / instance regex", "type": "textbox", "query": "cn[0-9]{4}(:9100)?", "current": {"text": "cn[0-9]{4}(:9100)?", "value": "cn[0-9]{4}(:9100)?"}}
  ]},
  "time": {"from": "now-1h", "to": "now"}, "timezone": "browser", "title": "HPC / Node Exporter Fleet (Start Here)", "uid": "hpc-node-exporter-fleet", "version": 1
}
