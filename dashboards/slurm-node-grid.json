{
  "annotations": {"list": []},
  "description": "Start-here Slurm node-state grid using slurm_node_info directly. No recording rules required.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Idle",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"IDLE\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "green"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Allocated",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"ALLOCATED\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "blue"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "Mixed",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"MIXED\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "semi-dark-yellow"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "Transitioning",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"COMPLETING|DRAINING|RESUME\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "orange"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "stat", "title": "Drained / maintenance",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"DRAINED|MAINT|POWERED_DOWN|POWER_DOWN\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "purple"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6, "type": "stat", "title": "Down / failing",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"refId": "A", "expr": "count(max by (cluster, node) (slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"DOWN|FAIL|FAILING|NO_RESPOND\"}))", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixedColor", "fixedColor": "red"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Slurm node cells",
      "description": "One cell per node from slurm_node_info. Filter directly on the Slurm node label; click a cell for node-exporter drill-down.",
      "gridPos": {"h": 28, "w": 24, "x": 0, "y": 4},
      "targets": [{
        "refId": "A",
        "expr": "sort(max by (cluster, node) ((0 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"IDLE\"}) or (1 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"ALLOCATED\"}) or (2 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=\"MIXED\"}) or (3 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"COMPLETING|DRAINING|RESUME\"}) or (4 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"DRAINED|MAINT|POWERED_DOWN|POWER_DOWN\"}) or (5 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state=~\"DOWN|FAIL|FAILING|NO_RESPOND\"}) or (6 * slurm_node_info{cluster=~\"$cluster\",partition=~\"$partition\",node=~\"$host_regex\",state!~\"IDLE|ALLOCATED|MIXED|COMPLETING|DRAINING|RESUME|DRAINED|MAINT|POWERED_DOWN|POWER_DOWN|DOWN|FAIL|FAILING|NO_RESPOND\"})))",
        "legendFormat": "{{node}}",
        "instant": true
      }],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "links": [{"title": "Open ${__field.name}", "url": "/d/hpc-node-exporter-node?var-host_regex=${__field.name}(:9100)?&var-instance=${__field.name}:9100", "targetBlank": false}],
          "mappings": [{"type": "value", "options": {
            "0": {"text": "IDLE", "color": "green"},
            "1": {"text": "ALLOCATED", "color": "blue"},
            "2": {"text": "MIXED", "color": "semi-dark-yellow"},
            "3": {"text": "TRANSITION", "color": "orange"},
            "4": {"text": "DRAINED", "color": "purple"},
            "5": {"text": "DOWN", "color": "red"},
            "6": {"text": "UNKNOWN", "color": "gray"}
          }}]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "name_and_value", "wideLayout": false, "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["hpc", "slurm", "nodes", "start-here"],
  "templating": {"list": [
    {"name": "host_regex", "label": "Slurm node-name regex", "type": "textbox", "query": "cn[0-9]{4}", "current": {"text": "cn[0-9]{4}", "value": "cn[0-9]{4}"}},
    {"name": "cluster", "label": "Cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(slurm_node_info{node=~\"$host_regex\"}, cluster)"}, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 1},
    {"name": "partition", "label": "Partition", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(slurm_node_info{cluster=~\"$cluster\",node=~\"$host_regex\"}, partition)"}, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 1}
  ]},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "HPC / Slurm Node Cell Grid (Start Here)",
  "uid": "hpc-slurm-node-grid",
  "version": 2
}
