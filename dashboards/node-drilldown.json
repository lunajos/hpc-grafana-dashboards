    {"name": "node", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(hpc:node_up{cluster=\"$cluster\"}, node)"}, "includeAll": false, "multi": false, "refresh": 1}
  ]},
