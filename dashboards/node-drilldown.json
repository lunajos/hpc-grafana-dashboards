{
  "annotations": {"list": []}, "editable": true, "graphTooltip": 1, "id": null,
  "panels": [
    {"id": 1, "type": "stat", "title": "Up", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_up{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "CPU busy", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_cpu_busy:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Memory used", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_memory_used:ratio{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Max temperature", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_temperature_max:celsius{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "Disk busy", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_disk_io_time:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "stat", "title": "Load / CPU", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"refId": "A", "expr": "hpc:node_load_per_cpu:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 7, "type": "timeseries", "title": "CPU modes", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"refId": "A", "expr": "avg by (mode) (rate(node_cpu_seconds_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]))", "legendFormat": "{{mode}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "PSI", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"refId": "A", "expr": "hpc:node_pressure_cpu_waiting:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "legendFormat": "CPU"}, {"refId": "B", "expr": "hpc:node_pressure_memory_waiting:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "legendFormat": "memory"}, {"refId": "C", "expr": "hpc:node_pressure_io_waiting:ratio5m{cluster=\"$cluster\",node=\"$node\"}", "legendFormat": "I/O"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "All hwmon temperature sensors", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"refId": "A", "expr": "node_hwmon_temp_celsius{cluster=\"$cluster\",node=\"$node\"}", "legendFormat": "{{chip}} {{sensor}}"}], "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Network throughput", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"refId": "A", "expr": "rate(node_network_receive_bytes_total{cluster=\"$cluster\",node=\"$node\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval])", "legendFormat": "{{device}} RX"}, {"refId": "B", "expr": "-rate(node_network_transmit_bytes_total{cluster=\"$cluster\",node=\"$node\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval])", "legendFormat": "{{device}} TX"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Disk latency", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"refId": "A", "expr": "rate(node_disk_read_time_seconds_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]) / clamp_min(rate(node_disk_reads_completed_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]), 0.001)", "legendFormat": "{{device}} read"}, {"refId": "B", "expr": "rate(node_disk_write_time_seconds_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]) / clamp_min(rate(node_disk_writes_completed_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]), 0.001)", "legendFormat": "{{device}} write"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "NFS operations by method", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "targets": [{"refId": "A", "expr": "sum by (method) (rate(node_nfs_requests_total{cluster=\"$cluster\",node=\"$node\"}[$__rate_interval]))", "legendFormat": "{{method}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}}
  ],
