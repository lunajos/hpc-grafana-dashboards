{
  "annotations": {"list": []},
  "description": "NFS, Ethernet, InfiniBand, disk, and filesystem metrics from plain node_exporter.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "NFS client RPC operations",
      "description": "Empty when the NFS client collector has no counters.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum by (instance, method) (rate(node_nfs_requests_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{method}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 2, "type": "timeseries", "title": "Ethernet throughput",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{job=~\"$job_regex\",instance=~\"$host_regex\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{device}} RX"},
        {"refId": "B", "expr": "-sum by (instance, device) (rate(node_network_transmit_bytes_total{job=~\"$job_regex\",instance=~\"$host_regex\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{device}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "id": 3, "type": "timeseries", "title": "Network errors and drops",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum by (instance) (rate(node_network_receive_errs_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} errors"},
        {"refId": "B", "expr": "sum by (instance) (rate(node_network_receive_drop_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]) + rate(node_network_transmit_drop_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} drops"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "InfiniBand data",
      "description": "Empty when the host or container cannot see /sys/class/infiniband.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (instance, device, port) (rate(node_infiniband_port_data_received_bytes_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{device}}:{{port}} RX"},
        {"refId": "B", "expr": "-sum by (instance, device, port) (rate(node_infiniband_port_data_transmitted_bytes_total{job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{device}}:{{port}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "InfiniBand errors and discards",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "sum by (instance, device, port, __name__) (rate({__name__=~\"node_infiniband_.*(errors|discards).*_total\",job=~\"$job_regex\",instance=~\"$host_regex\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{device}} {{__name__}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Disk utilization",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "rate(node_disk_io_time_seconds_total{job=~\"$job_regex\",instance=~\"$host_regex\",device!~\"loop.*|ram.*\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Filesystem capacity",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"refId": "A", "expr": "1 - node_filesystem_avail_bytes{job=~\"$job_regex\",instance=~\"$host_regex\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"} / node_filesystem_size_bytes{job=~\"$job_regex\",instance=~\"$host_regex\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"}", "legendFormat": "{{instance}} {{mountpoint}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["hpc", "storage", "fabric", "node-exporter", "start-here"],
  "templating": {"list": [
    {"name": "job_regex", "label": "Prometheus job regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}},
    {"name": "host_regex", "label": "Hostname / instance regex", "type": "textbox", "query": "cn[0-9]{4}(:9100)?", "current": {"text": "cn[0-9]{4}(:9100)?", "value": "cn[0-9]{4}(:9100)?"}}
  ]},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "HPC / Storage and Fabric (Start Here)",
  "uid": "hpc-storage-fabric",
  "version": 2
}
