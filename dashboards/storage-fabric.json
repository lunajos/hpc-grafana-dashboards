{
  "annotations": {"list": []}, "editable": true, "graphTooltip": 1, "id": null,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "NFS client RPC operations", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "sum by (method) (rate(node_nfs_requests_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{method}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Ethernet throughput", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "sum by (node, device) (rate(node_network_receive_bytes_total{cluster=~\"$cluster\",node=~\"$node\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval]))", "legendFormat": "{{node}} {{device}} RX"}, {"refId": "B", "expr": "-sum by (node, device) (rate(node_network_transmit_bytes_total{cluster=~\"$cluster\",node=~\"$node\",device!~\"lo|veth.*|docker.*|cni.*\"}[$__rate_interval]))", "legendFormat": "{{node}} {{device}} TX"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Network errors and drops", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "sum by (node) (rate(node_network_receive_errs_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{node}} errors"}, {"refId": "B", "expr": "sum by (node) (rate(node_network_receive_drop_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]) + rate(node_network_transmit_drop_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{node}} drops"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "InfiniBand data", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "description": "Counter names vary with kernel/driver. Verify this query during the rack pilot.", "targets": [{"refId": "A", "expr": "sum by (node, device, port) (rate(node_infiniband_port_data_received_bytes_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{node}} {{device}}:{{port}} RX"}, {"refId": "B", "expr": "-sum by (node, device, port) (rate(node_infiniband_port_data_transmitted_bytes_total{cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{node}} {{device}}:{{port}} TX"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "InfiniBand errors/discards", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "description": "Matches all monotonically increasing IB error/discard counters; refine after inventorying your drivers.", "targets": [{"refId": "A", "expr": "sum by (node, device, port, __name__) (rate({__name__=~\"node_infiniband_.*(errors|discards).*_total\",cluster=~\"$cluster\",node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{node}} {{device}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Disk utilization", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"refId": "A", "expr": "rate(node_disk_io_time_seconds_total{cluster=~\"$cluster\",node=~\"$node\",device!~\"loop.*|ram.*\"}[$__rate_interval])", "legendFormat": "{{node}} {{device}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Filesystem capacity", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"refId": "A", "expr": "1 - node_filesystem_avail_bytes{cluster=~\"$cluster\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"} / node_filesystem_size_bytes{cluster=~\"$cluster\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"}", "legendFormat": "{{node}} {{mountpoint}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}}
  ],
  "refresh": "30s", "schemaVersion": 41, "tags": ["hpc", "storage", "fabric"],
  "templating": {"list": [
