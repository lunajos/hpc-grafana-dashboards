{
  "annotations": {"list": []},
  "description": "Fast, recorded-metric overview of the HPC fleet.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Thermals", "type": "link", "url": "/d/hpc-thermals?var-cluster=$cluster&var-partition=$partition&var-rack=$rack", "includeVars": false, "keepTime": true},
    {"title": "Storage & fabric", "type": "link", "url": "/d/hpc-storage-fabric?var-cluster=$cluster&var-partition=$partition&var-rack=$rack", "includeVars": false, "keepTime": true}
  ],
  "panels": [
    {"id": 1, "type": "stat", "title": "Nodes down", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "count(hpc:node_up{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"} == 0)", "instant": true}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Nodes hot (>= 85 C)", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"refId": "A", "expr": "count(hpc:node_temperature_max:celsius{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"} >= 85)", "instant": true}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Fleet CPU busy", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "avg(hpc:node_cpu_busy:ratio5m{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Network errors/s", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "sum(hpc:node_network_errors:per_second5m{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "Max filesystem used", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "max(hpc:node_filesystem_used:ratio{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "stat", "title": "Memory PSI", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"refId": "A", "expr": "max(hpc:node_pressure_memory_waiting:ratio5m{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 7, "type": "status-history", "title": "Node availability over time", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 4}, "targets": [{"refId": "A", "expr": "hpc:node_up{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"}", "legendFormat": "{{rack}} / {{node}}"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}, "options": {"showValue": "never", "rowHeight": 0.7, "colWidth": 0.9, "legend": {"showLegend": true}}},
    {"id": 8, "type": "table", "title": "Current node offenders", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 14}, "targets": [{"refId": "A", "expr": "sort_desc(hpc:node_temperature_max:celsius{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "format": "table", "instant": true}, {"refId": "B", "expr": "sort_desc(hpc:node_cpu_busy:ratio5m{cluster=~\"$cluster\",partition=~\"$partition\",rack=~\"$rack\"})", "format": "table", "instant": true}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true}}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["hpc", "fleet"],
  "templating": {"list": [
    {"name": "cluster", "label": "Cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(hpc:node_up, cluster)", "refId": "cluster"}, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 1},
    {"name": "partition", "label": "Partition", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(hpc:node_up{cluster=~\"$cluster\"}, partition)", "refId": "partition"}, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 1},
    {"name": "rack", "label": "Rack", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(hpc:node_up{cluster=~\"$cluster\",partition=~\"$partition\"}, rack)", "refId": "rack"}, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 1}
  ]},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "HPC / Fleet Overview",
  "uid": "hpc-fleet-overview",
  "version": 1
}

